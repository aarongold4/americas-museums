---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import MuseumCard from '../components/MuseumCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const { Content } = await city.render();

// Build a slug → entry map once, then resolve the city's ranking in order
const allMuseums = await getCollection('museums');
const bySlug = new Map(
  allMuseums.map((m) => [m.id.replace(/\.json$/, ''), m])
);

const validMuseums = city.data.museum_slugs
  .map((slug) => {
    const entry = bySlug.get(slug);
    if (!entry) console.warn(`Missing museum entry referenced from ${city.slug}.mdx: ${slug}`);
    return entry;
  })
  .filter((m): m is NonNullable<typeof m> => Boolean(m));

const pageTitle = `${city.data.title} (${city.data.last_updated.getFullYear()} guide)`;
const pageDescription = city.data.intro;

// Metric strip for the hero — affiliate count is a useful signal
const ticketableCount = validMuseums.filter(
  (m) => m.data.affiliate && m.data.affiliate.network !== 'none'
).length;
const freeCount = validMuseums.filter((m) => m.data.admission_from === 0).length;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <NavBar slot="header" />

  <!-- Hero -->
  <section class="bg-white border-b border-surface-line">
    <div class="max-w-content mx-auto px-5 py-10">
      <div class="text-2xs tracking-wider2 text-brand font-medium mb-2">
        {city.data.city.toUpperCase()} · {city.data.state}
      </div>
      <h1 class="display text-4xl text-ink mb-3 leading-tight">{city.data.title}</h1>
      <p class="text-base text-ink-muted max-w-prose mb-4">{city.data.intro}</p>
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-muted">
        <span>Updated {city.data.last_updated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
        <span>·</span>
        <span>{city.data.read_minutes} min read</span>
        <span>·</span>
        <span>{validMuseums.length} museums</span>
        {ticketableCount > 0 && <><span>·</span><span>{ticketableCount} bookable</span></>}
        {freeCount > 0 && <><span>·</span><span>{freeCount} free</span></>}
      </div>
    </div>
  </section>

  <!-- Filter strip -->
  <div class="bg-white border-b border-surface-line sticky top-0 z-10">
    <div class="max-w-content mx-auto px-5 py-2.5 flex items-center gap-2 text-sm flex-wrap">
      <span class="badge badge-warn" id="result-count">{city.data.city} · {validMuseums.length} results</span>
      <select id="filter-type" class="filter-chip border border-surface-line rounded px-2 py-1 cursor-pointer bg-white">
        <option value="">All types</option>
        {[...new Set(validMuseums.map(m => m.data.discipline))].sort().map(d => (
          <option value={d}>{d}</option>
        ))}
      </select>
      <select id="filter-price" class="filter-chip border border-surface-line rounded px-2 py-1 cursor-pointer bg-white">
        <option value="">Any admission</option>
        <option value="free">Free only</option>
        <option value="under20">Under $20</option>
      </select>
      <select id="sort-by" class="filter-chip border border-surface-line rounded px-2 py-1 cursor-pointer bg-white">
        <option value="rated">Sort: top rated</option>
        <option value="popular">Sort: most reviewed</option>
        <option value="price-asc">Sort: price low→high</option>
        <option value="name">Sort: A→Z</option>
      </select>
    </div>
  </div>

  <!-- Editorial intro -->
  <section class="max-w-content mx-auto px-5 py-8 prose-editorial">
    <Content />
  </section>

  <!-- Results -->
  <section class="max-w-content mx-auto px-5 pb-12">
    <h2 class="sr-only">The ranking</h2>
    <ol id="museum-list" class="space-y-2.5" role="list">
      {validMuseums.map((m, i) => (
        <li
          data-discipline={m.data.discipline}
          data-admission={m.data.admission_from ?? 0}
          data-rating={m.data.rating ?? 0}
          data-reviews={m.data.review_count ?? 0}
          data-name={m.data.name}
        >
          <MuseumCard museum={m} rank={i + 1} />
        </li>
      ))}
    </ol>
  </section>

  <script is:inline>
    (function() {
      const list = document.getElementById('museum-list');
      const typeSel = document.getElementById('filter-type');
      const priceSel = document.getElementById('filter-price');
      const sortSel = document.getElementById('sort-by');
      const countEl = document.getElementById('result-count');
      if (!list) return;

      const items = Array.from(list.children);
      const originalText = countEl ? countEl.textContent : '';
      const cityName = originalText.split('·')[0].trim();

      function apply() {
        const type = typeSel.value;
        const price = priceSel.value;
        const sort = sortSel.value;

        // Filter
        let visible = items.filter(li => {
          if (type && li.dataset.discipline !== type) return false;
          const adm = parseFloat(li.dataset.admission);
          if (price === 'free' && adm !== 0) return false;
          if (price === 'under20' && adm >= 20) return false;
          return true;
        });

        // Sort
        visible.sort((a, b) => {
          if (sort === 'rated') return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
          if (sort === 'popular') return parseInt(b.dataset.reviews) - parseInt(a.dataset.reviews);
          if (sort === 'price-asc') return parseFloat(a.dataset.admission) - parseFloat(b.dataset.admission);
          if (sort === 'name') return a.dataset.name.localeCompare(b.dataset.name);
          return 0;
        });

        // Hide all, then show visible in order
        items.forEach(li => li.style.display = 'none');
        visible.forEach(li => {
          li.style.display = '';
          list.appendChild(li);
        });

        if (countEl) countEl.textContent = `${cityName} · ${visible.length} result${visible.length === 1 ? '' : 's'}`;
      }

      typeSel.addEventListener('change', apply);
      priceSel.addEventListener('change', apply);
      sortSel.addEventListener('change', apply);
    })();
  </script>

  <Footer slot="footer" />
</BaseLayout>

<!-- ItemList schema for the ranking — helps Google show rich list results -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: city.data.title,
    itemListElement: validMuseums.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${Astro.site}museum/${m.id.replace(/\.json$/, '')}/`,
      name: m.data.name,
    })),
  }, null, 2)}
/>
