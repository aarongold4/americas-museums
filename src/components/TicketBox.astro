---
import type { CollectionEntry } from 'astro:content';
import ticketLinks from '../data/ticket_links.json';

interface Props {
  museum: CollectionEntry<'museums'>['data'];
  slug: string;
}

const { museum: m, slug } = Astro.props;

// Resolution order:
//   1. src/data/ticket_links.json — the single file Aaron swaps affiliate links in
//   2. per-museum affiliate.deep_link in the museum JSON (legacy / overrides)
//   3. generic GetYourGuide search for the museum name+city
const linkEntry = (ticketLinks as Record<string, { url: string; network: string; product_name?: string }>)[slug];
const perMuseumAff = m.affiliate && m.affiliate.network !== 'none' && m.affiliate.deep_link
  ? { url: m.affiliate.deep_link, network: m.affiliate.network }
  : null;
const fallbackSearch = `https://www.getyourguide.com/s/?q=${encodeURIComponent(`${m.name} ${m.city}`)}`;

const ticket = linkEntry ?? perMuseumAff ?? { url: fallbackSearch, network: 'getyourguide-search' };
const isAffiliate = ticket.network !== 'official' && ticket.network !== 'none';

const priceLabel = m.admission_from === 0 ? 'Free' : (m.admission_from ? `$${m.admission_from}` : 'Varies');
---

<aside
  class="bg-surface-page border border-surface-line rounded-md p-3.5 min-w-[200px]"
  aria-label="Tickets and admission"
>
  <div class="text-2xs text-ink-muted mb-0.5">FROM</div>
  <div class="text-2xl font-medium text-ink mb-0.5 leading-none">{priceLabel}</div>
  <div class="text-2xs text-ink-muted mb-3">
    {m.admission_text}
    {isAffiliate && ' · skip the line'}
  </div>

  <a
    href={ticket.url}
    rel={isAffiliate ? 'sponsored nofollow noopener' : 'noopener'}
    target="_blank"
    class="btn-action w-full block text-center"
  >
    {isAffiliate ? 'Get tickets' : 'Visit official site'}
  </a>

  {isAffiliate && (
    <div class="text-center text-2xs text-ink-muted mt-1.5 leading-snug">
      Affiliate link — we may earn a small commission at no extra cost to you.
    </div>
  )}
</aside>
