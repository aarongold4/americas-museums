---
interface Props {
  variant?: 'primary' | 'condensed';
  backLabel?: string;
  backHref?: string;
}

const {
  variant = 'primary',
  backLabel,
  backHref = '/',
} = Astro.props;
---

{variant === 'primary' ? (
  <header class="bg-brand text-white">
    <div class="max-w-content mx-auto px-5 py-3.5 flex items-center justify-between">
      <a href="/" class="font-medium text-base tracking-tightish">
        americasmuseums<span class="opacity-70">.com</span>
      </a>
      <nav class="flex items-center gap-5 text-sm">
        <a href="/cities" class="hover:opacity-90">Cities</a>
        <a href="/types" class="hover:opacity-90">By type</a>
        <a href="/exhibits" class="hover:opacity-90">Exhibits</a>
        <a href="/about" class="hover:opacity-90 opacity-90">About</a>
      </nav>
    </div>
  </header>
) : (
  <header class="bg-brand text-white">
    <div class="max-w-content mx-auto px-5 py-2.5">
      <a href={backHref} class="text-xs hover:opacity-90">
        ← {backLabel ?? 'Back'}
      </a>
    </div>
  </header>
)}
